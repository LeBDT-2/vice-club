# ---------------------------------------------------------------------------
# VICE CLUB — variables d'environnement (ne JAMAIS committer de vraies valeurs)
# Copie ce fichier en .env.local pour le développement.
# ---------------------------------------------------------------------------

# Environnement applicatif : local | test | preview | production
APP_ENV=local

# URL publique du site (HTTPS obligatoire en production). Sert aux liens d'e-mail.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — URL du projet et clé PUBLIABLE (sb_publishable_...). Exposées au navigateur.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase — clé SECRÈTE (sb_secret_...). SERVEUR UNIQUEMENT, jamais préfixée NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Sel HMAC pour les empreintes d'IP / e-mail utilisées par la limitation de débit.
# Générer : openssl rand -base64 48
RATE_LIMIT_SALT=change-me-with-at-least-32-random-characters

# Anti-bot Cloudflare Turnstile (gratuit). La clé SECRÈTE se configure dans Supabase
# (Authentication → Attack Protection), pas ici.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# En production, l'absence de Turnstile bloque le démarrage sauf acceptation explicite :
ANTIBOT_DISABLED_ACKNOWLEDGED=false
